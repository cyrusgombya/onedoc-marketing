{
    "name": "onedoc/marketing",
    "description": "ONEDOC Marketing Website",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "ONEDOC Team",
            "email": "info@onedoc.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "laravel/tinker": "^2.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.20",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.5",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
